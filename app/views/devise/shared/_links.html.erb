<%# Only the modules the User model actually enables (registerable,
    recoverable, confirmable) — lockable and omniauth are not in use, so the
    branches Devise ships for them were dropped. %>
<div class="auth__links">
  <% if controller_name != 'sessions' %>
    <%= link_to t('page.auth.have_account'), new_session_path(resource_name) %>
  <% end %>

  <% if devise_mapping.registerable? && controller_name != 'registrations' %>
    <%= link_to t('page.auth.no_account'), new_registration_path(resource_name) %>
  <% end %>

  <% if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to t('page.auth.forgot_link'), new_password_path(resource_name) %>
  <% end %>

  <% if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <%= link_to t('page.auth.confirm_link'), new_confirmation_path(resource_name) %>
  <% end %>
</div>
