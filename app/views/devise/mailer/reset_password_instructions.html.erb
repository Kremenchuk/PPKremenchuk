<%# All routes live inside `scope '/:locale'`, and mailers do not inherit
    ApplicationController#default_url_options — so the locale has to be
    passed explicitly or url generation raises "missing required keys". %>
<p><%= t('page.auth.mail.greeting', email: @resource.email) %></p>

<p><%= t('page.auth.mail.reset_instruction') %></p>

<p><%= link_to t('page.auth.mail.reset_action'), edit_password_url(@resource, reset_password_token: @token, locale: I18n.locale) %></p>

<p><%= t('page.auth.mail.ignore') %></p>
<p><%= t('page.auth.mail.reset_note') %></p>
