<div class="auth">
  <div class="auth__card">
    <p class="eyebrow"><span class="eyebrow__tick"></span><%= t('page.layout.sign_in') %></p>
    <h1 class="auth__title"><%= t('page.auth.reset_header') %></h1>
    <p class="auth__lead"><%= t('page.auth.reset_lead') %></p>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: 'auth__form' }) do |f| %>
      <%= f.hidden_field :reset_password_token %>

      <div class="auth-field">
        <%= f.label :password, t('page.auth.password_new') %>
        <% if @minimum_password_length %>
          <span class="auth-field__hint"><%= t('page.auth.min_chars', count: @minimum_password_length) %></span>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: 'new-password' %>
      </div>

      <div class="auth-field">
        <%= f.label :password_confirmation, t('page.auth.password_confirm') %>
        <%= f.password_field :password_confirmation, autocomplete: 'new-password' %>
      </div>

      <%= f.button t('page.auth.reset_submit'), class: 'btn btn--lg btn--block' %>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
