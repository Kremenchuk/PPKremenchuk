.pdp
  %section.pdp-hero
    %nav.pdp-crumbs
      = link_to t('page.all.home'), root_path
      %span.sep /
      = link_to t('page.home.nav.products'), "#{root_path}#products"
      %span.sep /
      %span.cur= t('page.trolleys.index.header')
    %p.eyebrow
      %span.eyebrow__tick
      = t('page.trolleys.show.header')
    %h1.pdp-title= t('page.trolleys.index.header')
    %p.pdp-lead= t('page.trolleys.index.lead')
    %ul.pdp-chips
      %li
        %b= t('page.all.lenght')
        = "600–1500 #{t('page.all.mm')}"
      %li
        %b= t('page.all.widht')
        = "500–1200 #{t('page.all.mm')}"
      %li
        %b= t('page.trolleys.index.handle_height')
        = "600–1200 #{t('page.all.mm')}"
      %li
        %b= t('page.trolleys.index.weight')
        = "50–400 #{t('page.all.kg')}"

  #actual_price
    - if @price_trol.present?
      = render partial: 'show_actual_price'

  -# MODELS (hidden when printing the calculation)
  #no_print
    .pdp-block
      -# delivery caveats — the two things a buyer must know before using
      -# the calculator, so they get a callout rather than body copy
      .pdp-note
        %span.pdp-note__mark !
        .pdp-note__body= raw t('page.trolleys.index.about')
      .pdp-prose= raw t('page.trolleys.index.about_sec')

    .pdp-block
      .tgrid
        - trolley_models.each do |model|
          = render 'model', model: model

- if @price_trol.present?
  :javascript
    document.location.hash = "#actual_price";
