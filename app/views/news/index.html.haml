.pdp
  %section.pdp-hero
    %nav.pdp-crumbs
      = link_to t('page.all.home'), root_path
      %span.sep /
      %span.cur= t('page.news.header')
    %h1.pdp-title= t('page.news.header')
    %p.pdp-lead= t('page.news.lead')

  .pdp-block
    - if @news.present?
      .ed-list
        - @news.each do |item|
          %article.ed-item
            - if item.photo.present?
              = link_to news_path(item.id), class: 'ed-item__media' do
                = image_tag item.photo, alt: localized(item.title)
            .ed-item__body
              %time.ed-item__date{ datetime: item.news_date.to_fs(:iso8601) }
                = item.news_date.strftime('%d.%m.%Y')
              %h2.ed-item__title= link_to localized(item.title), news_path(item.id)
              %p.ed-item__excerpt= localized(item.short_text)
              = link_to news_path(item.id), class: 'ed-more' do
                = t('page.news.read_more')
                %i.arr →
    - else
      %p.ed-empty= t('page.news.empty')
