.pdp
  %section.pdp-hero
    %nav.pdp-crumbs
      = link_to 'Новини', news_admin_index_path
      %span.sep /
      %span.cur= localized(@news.title)
    %h1.pdp-title Редагування

  .pdp-block
    = render 'new_edit_form', news: @news, url: news_path(@news.id), method: :put, submit_label: 'Сохранить'
    = link_to news_admin_index_path, class: 'ed-back' do
      %i.arr ←
      Назад до списку
