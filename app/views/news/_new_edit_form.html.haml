-# Shared create/edit form.
-#   news         – the record being edited (News.new for a create)
-#   url, method  – where to post
-#   submit_label – button caption
-#   with_photo   – the photo field is only shown on create: NewsController#update
-#                  permits title/short_text/text/news_date and never touches
-#                  the file, so on edit it would be a control that does nothing
- with_photo = local_assigns.fetch(:with_photo, false)

.adm-card
  - if flash[:message].present?
    -# own modifier instead of Bootstrap's .alert-danger, whose pale
    -# pink background made the light text unreadable on the dark theme
    %p.adm-flash{ class: ('adm-flash--error' if flash[:class].to_s.include?('danger')) }= flash[:message]

  = form_tag url, method: method, multipart: true do
    - if with_photo
      .adm-field
        %label.adm-label{ for: 'photo' } Картинка
        = file_field_tag :photo, class: 'adm-file'

    .adm-field
      %label.adm-label{ for: 'news_date' } Дата
      = date_field_tag :news_date, (news.news_date || Date.current), class: 'adm-input'

    - { 'Заголовок' => :title, 'Короткое описание' => :short_text }.each do |caption, attr|
      .adm-field
        %span.adm-label= caption
        .adm-langs
          - %w[uk en ru].each do |lc|
            %label.adm-lang
              %span.adm-lang__tag= lc
              = text_field_tag "#{attr}[#{lc}]", news.public_send(attr).to_h[lc], class: 'adm-input'

    .adm-field
      %span.adm-label Текст
      .adm-langs.adm-langs--stacked
        - %w[uk en ru].each do |lc|
          %label.adm-lang
            %span.adm-lang__tag= lc
            = text_area_tag "text[#{lc}]", news.text.to_h[lc], class: 'adm-input adm-textarea'

    .adm-actions
      = submit_tag submit_label, class: 'btn btn--sm'
