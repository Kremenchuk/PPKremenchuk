.pdp
  %section.pdp-hero
    %h1.pdp-title Новини

  .pdp-block
    %h2.adm-h2 Додати новину
    = render 'new_edit_form', news: @new_news, url: news_index_path, method: :post, submit_label: 'Добавить', with_photo: true

  .pdp-block
    %h2.adm-h2 Опубліковані
    - if @news.present?
      .adm-rows
        - @news.each do |item|
          .adm-row
            - if item.photo.present?
              .adm-row__media= image_tag item.photo, alt: localized(item.title)
            .adm-row__body
              %span.adm-row__date= item.news_date.strftime('%d.%m.%Y')
              %h3.adm-row__title= localized(item.title)
              %p.adm-row__text= localized(item.short_text)
            .adm-row__actions
              = link_to 'Редактировать', edit_news_path(item.id), class: 'btn btn--sm btn--ghost'
              = link_to 'Удалить', news_path(id: item.id), class: 'btn btn--sm adm-danger', method: :delete
    - else
      %p.ed-empty Новин ще немає.
