.pdp
  %section.pdp-hero
    %nav.pdp-crumbs
      = link_to t('page.all.home'), root_path
      %span.sep /
      = link_to t('page.news.header'), news_index_path
      %span.sep /
      %span.cur= @news.news_date.strftime('%d.%m.%Y')
    %p.eyebrow
      %span.eyebrow__tick
      = @news.news_date.strftime('%d.%m.%Y')
    %h1.pdp-title= localized(@news.title)

  - if @news.photo.present?
    %figure.pdp-figure
      = image_tag @news.photo, alt: localized(@news.title)

  .pdp-block
    .pdp-prose= raw localized(@news.text)
    = link_to news_index_path, class: 'ed-back' do
      %i.arr ←
      = t('page.news.back')
