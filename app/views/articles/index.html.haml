.pdp
  %section.pdp-hero
    %nav.pdp-crumbs
      = link_to t('page.all.home'), root_path
      %span.sep /
      %span.cur= t('page.articles.header')
    %h1.pdp-title= t('page.articles.header')
    %p.pdp-lead= t('page.articles.lead')

  .pdp-block
    - if @articles.present?
      .ed-list.ed-list--plain
        - @articles.each do |article|
          %article.ed-item.ed-item--plain
            .ed-item__body
              %h2.ed-item__title= link_to raw(localized(article.title)), article_path(id: article.id)
              .ed-item__excerpt= raw localized(article.short_body)
              = link_to article_path(id: article.id), class: 'ed-more' do
                = t('page.articles.read_more')
                %i.arr →
    - else
      %p.ed-empty= t('page.articles.empty')
