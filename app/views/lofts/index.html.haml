.pdp
  %section.pdp-hero
    %nav.pdp-crumbs
      = link_to t('page.all.home'), root_path
      %span.sep /
      = link_to t('page.home.nav.products'), "#{root_path}#products"
      %span.sep /
      %span.cur= t('page.loft.index.header')
    %p.eyebrow
      %span.eyebrow__tick
      = t('page.home.nav.products')
    %h1.pdp-title= t('page.loft.index.header')
    %p.pdp-lead= t('page.loft.index.lead')

  %figure.pdp-figure
    = image_tag('design/all_parts/loft/stellag_dlya_knig.jpg', alt: t('page.loft.index.header'))

  .pdp-block
    .pdp-prose= raw t('page.loft.index.about')
