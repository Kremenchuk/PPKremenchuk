-# Fields shared by the create and edit forms. The inputs are named
-# explicitly (title[uk] …) because Article stores each field as a JSON
-# hash keyed by locale, so no form builder is involved.
- { 'Заголовок' => :title, 'Короткое описание' => :short_body }.each do |caption, attr|
  .adm-field
    %span.adm-label= caption
    .adm-langs
      - %w[uk en ru].each do |lc|
        %label.adm-lang
          %span.adm-lang__tag= lc
          = text_field_tag "#{attr}[#{lc}]", @article.public_send(attr).to_h[lc], class: 'adm-input'

.adm-field
  %span.adm-label Текст
  .adm-langs.adm-langs--stacked
    - %w[uk en ru].each do |lc|
      %label.adm-lang
        %span.adm-lang__tag= lc
        = text_area_tag "body[#{lc}]", @article.body.to_h[lc], class: 'adm-input adm-textarea'
