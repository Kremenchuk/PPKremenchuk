.pdp
  %section.pdp-hero
    %nav.pdp-crumbs
      = link_to 'Статті', admin_articles_path
      %span.sep /
      %span.cur Нова стаття
    %h1.pdp-title Нова стаття

  .pdp-block
    .adm-card
      - if flash[:message].present?
        -# own modifier instead of Bootstrap's .alert-danger, whose pale
        -# pink background made the light text unreadable on the dark theme
        %p.adm-flash{ class: ('adm-flash--error' if flash[:class].to_s.include?('danger')) }= flash[:message]
      = form_tag admin_articles_path, method: :post do
        = render 'new_edit'
        .adm-actions
          = submit_tag 'Save', class: 'btn btn--sm'
