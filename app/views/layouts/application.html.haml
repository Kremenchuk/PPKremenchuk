!!!
%html
  %head


    -#%meta{:content => "3ZGMYXXCBZBQNEZbdqB9TBw7nJ7IG609UeI7l3BJUXM", :name => "google-site-verification"}
    %meta{:content => "width=device-width, initial-scale=1", :name => "viewport"}
    %meta{:content => @meta_tags, :name => "description"}
    %meta{:charset => "UTF-8"}
    %meta{:content => "oDjA70vXXP26uDmLtYLA3sgyJbRfaieDhim20ggP6XA", :name => "google-site-verification"}
    -#%meta{:name => "viewport", content: "width=device-width, initial-scale=1"}
    %title
      =t('page.layout.title')

    %script{:async => "", :src => "https://www.googletagmanager.com/gtag/js?id=UA-129364309-2"}
    = csrf_meta_tags
    = csp_meta_tag
    %link{:rel => "preconnect", :href => "https://fonts.googleapis.com"}
    %link{:rel => "preconnect", :href => "https://fonts.gstatic.com", :crossorigin => ""}
    %link{:rel => "stylesheet", :href => "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Manrope:wght@400;500;600;700;800&family=Oswald:wght@300;400;500;600;700&display=swap"}
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_include_tag "application", "data-turbo-track": "reload", defer: true

    = favicon_link_tag 'stm_industry_black_100_50.jpg'
  %body.stm-redesign
    .grain{"aria-hidden" => "true"}
    .main{"data-controller" => "site"}

      -# ░░ TOPBAR ░░
      .topbar
        .wrap.topbar__in
          %span.topbar__item.topbar__item--address= t('page.home.topbar.address')
          %span.topbar__spacer
          %span.topbar__lang
            - I18n.available_locales.each do |loc|
              - next if loc == I18n.locale
              = link_to t(loc), locale_path(:new_locale => loc)
          %span.topbar__sep{"aria-hidden" => "true"}
          %span.topbar__auth
            - if current_user
              - if current_user.admin?
                = link_to t('page.layout.admin_constants'), edit_constant_path(1), class: 'topbar__admin'
              = link_to current_user.email, edit_user_registration_path
              = button_to t('page.layout.sign_out'), destroy_user_session_path, method: :delete
            - else
              = link_to t('page.layout.sign_in'), new_user_session_path
          %span.topbar__sep{"aria-hidden" => "true"}
          = link_to t('page.home.topbar.email'), "mailto:#{t('page.home.topbar.email')}", class: 'topbar__item topbar__mail'

      -# ░░ HEADER ░░
      %header.header#top
        .wrap.header__in
          = link_to root_path, class: 'brand', 'aria-label' => 'STM Industry' do
            = image_tag "design/all_parts/Header/stm_industry_white_logo_350.png", class: 'brand__logo', alt: 'STM Industry'
          %nav.nav{"data-site-target" => "nav"}
            = link_to t('page.home.nav.products'),   "#{root_path}#products"
            = link_to t('page.home.nav.production'), "#{root_path}#gallery"
            = link_to t('page.home.nav.delivery'),   "#{root_path}#delivery"
            = link_to t('page.home.nav.gallery'),    gallery_index_path
            = link_to t('page.home.nav.contacts'),   "#{root_path}#contact"
          .header__cta
            = link_to t('page.home.cta'), "#{root_path}#contact", class: 'btn btn--sm'
            %button.burger{"data-site-target" => "burger", "data-action" => "site#toggleNav", "aria-label" => "Menu", "aria-expanded" => "false"}
              %span
              %span
              %span

      -# ░░ CONTENT ░░
      - if controller_name == 'welcome' && action_name == 'index'
        = yield
      - else
        .wrapper
          = yield

      -# ░░ FOOTER ░░
      %footer.footer
        .wrap.footer__in
          .footer__brand
            = image_tag "design/all_parts/Header/stm_industry_white_logo_350.png", alt: 'STM Industry'
            %p= t('page.home.footer.about')
          .footer__col
            %h5= t('page.home.footer.products_title')
            = link_to t('page.welcome.stillage'),           stillage_index_path
            = link_to t('page.welcome.stillage_warehouse'), stillage_warehouse_index_path
            = link_to t('page.welcome.stillage_pallet'),    stillage_pallet_index_path
            = link_to t('page.welcome.stillage_mezonin'),   mezzanine_index_path
            = link_to t('page.welcome.platform'),           platform_index_path
            = link_to t('page.welcome.loft'),               lofts_path
          .footer__col
            %h5= t('page.home.footer.company_title')
            = link_to t('page.home.nav.production'), "#{root_path}#why"
            = link_to t('page.home.nav.delivery'),   "#{root_path}#delivery"
            = link_to t('page.welcome.gallery'),     gallery_index_path
            = link_to t('page.layout.drop_menu.about_us'), about_us_path
            = link_to t('page.layout.drop_menu.news'),     news_index_path
            = link_to t('page.layout.drop_menu.article'),  articles_path
          .footer__col
            %h5= t('page.home.footer.contacts_title')
            = link_to t('page.home.topbar.email'), "mailto:#{t('page.home.topbar.email')}"
            = link_to t('page.home.contact.address_value'), "#{root_path}#contact"
            = link_to 'Sitemap', sitemap_path
        .wrap.footer__bottom
          %span
            ©
            %span#year= Date.current.year
            = t('page.home.footer.rights')
          = link_to t('page.contacts.index.map'), 'https://www.google.com/maps/search/?api=1&query=49.9692534%2C36.2371595', target: '_blank', rel: 'noopener', class: 'footer__made'


