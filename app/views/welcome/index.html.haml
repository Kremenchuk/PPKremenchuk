.home
  -# ░░ HERO — scroll-morph stage (one rack, four worlds) ░░
  %section.scrollstage#hero{"data-controller" => "hero"}
    .scrollstage__sticky
      %canvas.scrollstage__canvas{"data-hero-target" => "canvas", "aria-hidden" => "true"}
      .scrollstage__grid{"aria-hidden" => "true"}
      .scrollstage__fallback{"aria-hidden" => "true"}
        = image_tag "design/all_parts/background.jpg", alt: ""
      %span.hero__side{"aria-hidden" => "true"} EST · 2002 · KHARKIV · UA
      .wrap.scrollstage__ui
        .scrollstage__lead
          %p.eyebrow
            %span.eyebrow__tick
            = t('page.home.hero.eyebrow')
          %h1.hero__title
            %span= t('page.home.hero.title_1')
            %span= t('page.home.hero.title_2')
            %span.hero__title--accent= t('page.home.hero.title_accent')
          .scrollstage__caps
            - Array(t('page.home.stage.scenes')).each_with_index do |sc, i|
              %article.scrollstage__cap{"data-hero-target" => "cap", "data-scene" => i}
                %span.scrollstage__kicker= sc[:kicker]
                %p.scrollstage__text= sc[:text]
          .hero__actions
            = link_to "#{root_path}#products", class: 'btn btn--lg' do
              = t('page.home.hero.cta_primary')
              %i.arr →
            = link_to t('page.home.hero.cta_secondary'), "#{root_path}#why", class: 'btn btn--ghost btn--lg'
      .scrollstage__dots{"aria-hidden" => "true"}
        - Array(t('page.home.stage.scenes')).each_with_index do |_sc, i|
          %span.scrollstage__dot{"data-hero-target" => "dot", "data-scene" => i}
      %span.scrollstage__hint{"aria-hidden" => "true"}
        = t('page.home.stage.hint')
        %i ↓

  -# ░░ STATS ░░
  %section.stats#stats
    .wrap.stats__grid
      - Array(t('page.home.stats')).each_with_index do |stat, i|
        .stat.reveal{:style => "--d:#{i * 0.08}s"}
          .stat__num
            %span= stat[:num]
            - if stat[:suffix].present?
              %i= stat[:suffix]
          .stat__label= stat[:label]

  -# ░░ PRODUCTS ░░
  %section.section.products#products
    .wrap
      %header.sec-head
        %p.eyebrow
          %span.eyebrow__tick
          = t('page.home.products.eyebrow')
        %h2.sec-title
          = t('page.home.products.title_pre')
          %em= t('page.home.products.title_accent')
        %p.sec-sub= t('page.home.products.sub')
      .cards
        - welcome_products.each_with_index do |p, i|
          - idx = format('%02d', i + 1)
          - if p[:image]
            = link_to p[:path], class: 'card reveal', style: "--d:#{i * 0.06}s" do
              .card__media= image_tag p[:image], alt: p[:title], loading: 'lazy'
              .card__body
                %span.card__idx= idx
                %h3= p[:title]
                %p= t("page.home.products_items.#{p[:key]}.desc")
                .card__foot
                  %span.spec= t("page.home.products_items.#{p[:key]}.spec")
                  %i.arr →
          - else
            = link_to p[:path], class: 'card card--feature reveal', style: "--d:#{i * 0.06}s" do
              %span.card__icon
                %i.fa{:class => p[:icon]}
              .card__body
                %span.card__idx= idx
                %h3= p[:title]
                %p= t("page.home.products_items.#{p[:key]}.desc")
                .card__foot
                  %span.spec= t("page.home.products_items.#{p[:key]}.spec")
                  %i.arr →

  -# ░░ WHY / PRODUCTION ░░
  %section.section.why#why
    .why__rule{"aria-hidden" => "true"}
    .wrap
      %header.sec-head.sec-head--split
        %div
          %p.eyebrow
            %span.eyebrow__tick
            = t('page.home.why.eyebrow')
          %h2.sec-title
            = t('page.home.why.title_pre')
            %em= t('page.home.why.title_accent')
        %p.sec-sub= t('page.home.why.sub')
      .feats
        - feat_icons = %w[fa-industry fa-spray-can fa-shield-alt fa-ruler-combined fa-truck fa-tools]
        - Array(t('page.home.why.feats')).each_with_index do |feat, i|
          .feat.reveal{:style => "--d:#{i * 0.06}s"}
            %span.feat__ico
              %i.fa{:class => feat_icons[i] || 'fa-check'}
            %h4= feat[:title]
            %p= feat[:text]

  -# ░░ SHOWCASE ░░
  %section.showcase#gallery
    .showcase__media
      = image_tag "design/all_parts/background.jpg", alt: t('page.home.showcase.title_accent'), loading: 'lazy'
      .showcase__shade
    .wrap.showcase__in
      .showcase__card.reveal
        %p.eyebrow
          %span.eyebrow__tick
          = t('page.home.showcase.eyebrow')
        %h2.sec-title
          = t('page.home.showcase.title_pre')
          %br
          %em= t('page.home.showcase.title_accent')
        %p= t('page.home.showcase.text')
        .showcase__metrics
          - Array(t('page.home.showcase.metrics')).each do |m|
            %div
              %b= m[:value]
              %span= m[:label]
        = link_to "#{root_path}#contact", class: 'btn btn--lg' do
          = t('page.home.showcase.cta')
          %i.arr →

  -# ░░ DELIVERY MARQUEE ░░
  %section.delivery#delivery
    .wrap.delivery__head
      %p.eyebrow.eyebrow--center
        %span.eyebrow__tick
        = t('page.home.delivery_eyebrow')
      %h2.sec-title.sec-title--center
        = t('page.welcome.delivery_title_pre')
        %em= t('page.welcome.delivery_title_accent')
    .marquee{"aria-hidden" => "true"}
      .marquee__track
        - 2.times do
          - Array(t('page.welcome.delivery_cities')).each do |city|
            %span= city
            %span.dot /

  -# ░░ SEO / EDITORIAL (kept for search engines & internal linking) ░░
  %section.section.prose-seo
    .wrap
      %header.sec-head.sec-head--center
        %p.eyebrow
          %span.eyebrow__tick
          = t('page.home.seo_eyebrow')
        %h2.sec-title.sec-title--center= t('page.welcome.h3_met_stel')
      .prose.prose--center
        %p= "#{t('page.welcome.text_met_stel_anons')} #{t('page.welcome.text_met_stel_block')}"
        %h3= t('page.welcome.h3_we_create')
        - welcome_reductions.each do |id, link_key, path, anons_key, _block_key|
          %p
            = link_to t("page.welcome.#{link_key}"), path
            = t("page.welcome.#{anons_key}")

  -# ░░ CONTACT / CTA ░░
  %section.section.contact#contact
    .contact__glow{"aria-hidden" => "true"}
    .wrap.contact__grid
      .contact__left.reveal
        %p.eyebrow
          %span.eyebrow__tick
          = t('page.home.contact.eyebrow')
        %h2.sec-title
          = t('page.home.contact.title_pre')
          %br
          %em= t('page.home.contact.title_accent')
        %p.contact__lead= t('page.home.contact.lead')
        %ul.contact__list
          %li
            %span= t('page.home.contact.email_label')
            = link_to t('page.home.topbar.email'), "mailto:#{t('page.home.topbar.email')}"
          - phone = t('page.home.topbar.tel_number', default: '').to_s.strip
          - if phone.present? && phone != '-'
            %li
              %span= t('page.home.contact.phone_label')
              = link_to phone, "tel:#{phone.gsub(/[^\d+]/, '')}"
          %li
            %span= t('page.home.contact.address_label')
            %span= t('page.home.contact.address_value')
          %li
            %span= t('page.home.contact.map_label')
            = link_to t('page.contacts.index.map'), 'https://www.google.com/maps/search/?api=1&query=49.9692534%2C36.2371595', target: '_blank', rel: 'noopener'
          %li
            %span= t('page.home.contact.company_label')
            %span= t('page.home.contact.company_value')
      %form.form.reveal{:style => "--d:.1s", :action => contact_request_path, :method => "post", "data-action" => "submit->site#sendMail"}
        .form__row
          %label
            = t('page.home.contact.form.name')
            %input{:type => "text", :name => "name", :required => true, :placeholder => t('page.home.contact.form.name_ph')}
          %label
            = t('page.home.contact.form.phone')
            %input{:type => "tel", :name => "phone", :required => true, :placeholder => t('page.home.contact.form.phone_ph')}
        %label
          = t('page.home.contact.form.msg')
          %textarea{:name => "msg", :rows => "3", :placeholder => t('page.home.contact.form.msg_ph')}
        %button.btn.btn--lg.btn--block{:type => "submit"}
          = t('page.home.contact.form.submit')
          %i.arr →
        %p.form__note{"data-site-target" => "note", "data-error-text" => t('page.home.contact.form.error'), :hidden => true}= t('page.home.contact.form.note')
