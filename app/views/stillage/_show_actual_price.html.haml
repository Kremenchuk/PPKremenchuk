.pdp-result
  .pdp-result__head
    %span.pdp-result__name= @name_stilage
    - print_name = "#{t('page.stillage.show.header')} #{@name_stilage}"
    %button.pdp-print{ type: 'button', title: t('page.all.print'), data: { controller: 'print', action: 'click->print#run', 'print-name-value': print_name } }
      🖨
  .pdp-result__grid
    %ul.pdp-result__specs
      %li
        %span.k= t('page.all.max_load')
        %span.v= "#{@shelf_load_var} #{t('page.all.kg')}"
      %li
        %span.k= t('page.all.weight')
        %span.v= "#{@wei_stilage} #{t('page.all.kg')}"
      %li.price-row
        %span.k= t('page.all.price')
        %span.v= "#{@price_stillage} #{t('page.all.uah')}"
    .pdp-result__dims
      %span.pdp-result__dim
        %b= t('page.all.height')
        = "#{@hight_var} #{t('page.all.mm')}"
      %span.pdp-result__dim
        %b= t('page.all.widht')
        = "#{@width_var} #{t('page.all.mm')}"
      %span.pdp-result__dim
        %b= t('page.all.depth')
        = "#{@depth_var} #{t('page.all.mm')}"
      %span.pdp-result__dim
        %b= t('page.all.num_of_shelves')
        = "#{@num_of_shelves_var} #{t('page.all.unit')}"
