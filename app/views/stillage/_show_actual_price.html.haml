.pdp-result
  .pdp-result__head
    %span.pdp-result__name= @name_stilage
    = button_to '', class: 'pdp-print', onclick: 'window.print(); return false;', title: t('page.all.print') do
      🖨
  .pdp-result__grid
    %ul.pdp-result__specs
      %li
        %span.k= t('page.all.max_load')
        %span.v= "#{@shelf_load_var} #{t('page.all.kg')}"
      %li
        %span.k= t('page.all.weight')
        %span.v= "#{@wei_stilage} #{t('page.all.kg')}"
      %li.price-row
        %span.k= t('page.all.price')
        %span.v= "#{@price_stillage} #{t('page.all.uah')}"
    .pdp-result__diagram
      .dimensions_stillage
        .dimension_image_stilage
          .height_size_stilage
            ="#{@hight_var}"
          .widht_size_stilage
            ="#{@width_var}"
          .depth_size_stilage
            ="#{@depth_var}"
          =image_tag("design/all_parts/stillage_arxiv/stillage_show_dimension 45.gif", class: "dimaension_image_size_stilage")
