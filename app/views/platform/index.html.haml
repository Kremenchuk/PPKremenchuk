.pdp
  %section.pdp-hero
    %nav.pdp-crumbs
      = link_to t('page.all.home'), root_path
      %span.sep /
      = link_to t('page.home.nav.products'), "#{root_path}#products"
      %span.sep /
      %span.cur= t('page.platform.index.header')
    %p.eyebrow
      %span.eyebrow__tick
      = t('page.home.nav.products')
    %h1.pdp-title= t('page.platform.index.header')
    %p.pdp-lead= t('page.platform.index.lead')

  %figure.pdp-figure
    = image_tag('design/all_parts/platform/3.JPG', alt: t('page.platform.index.header'), class: 'pdp-figure__img--lift')

  .pdp-block
    .pdp-prose= raw t('page.platform.index.about')
