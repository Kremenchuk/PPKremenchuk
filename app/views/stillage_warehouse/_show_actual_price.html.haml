-# NB: no .stillage-warehouse class — print.scss pins that selector to the
-# old Bootstrap markup (.item-info { width: 220mm }, mm-based caption
-# offsets), which squeezes the new layout. Print geometry lives in
-# product.scss now. `.prist_section` is a bare selector there and still
-# hides the second drawing when printing.
.pdp-result
  .pdp-result__head
    %span.pdp-result__name= @name_stillage
    - print_name = "#{t('page.stillage_warehouse.show.short')} #{@name_stillage}"
    .print-button-section
      %button.pdp-print.print-button{ type: 'button', title: t('page.all.print'), data: { controller: 'print', action: 'click->print#run', 'print-name-value': print_name } }
        🖨

  .item-info
    %ul.pdp-result__specs.pdp-result__specs--row
      %li
        %span.k= t('page.stillage_warehouse.show.max_load_ur')
        %span.v= "#{@shelf_load_var} #{t('page.all.kg')}"
      %li
        %span.k= t('page.stillage_warehouse.show.weight_osn_sec')
        %span.v= "#{@wei_osn} #{t('page.all.kg')}"
      %li
        %span.k= t('page.stillage_warehouse.show.weight_pris_sec')
        %span.v= "#{@wei_pris} #{t('page.all.kg')}"

    .pdp-pricetable
      %table
        %thead
          %tr
            %th.header_table.table_ram_width
              = t('page.all.rama')
              %span.sub= "#{@hight_var}x#{@depth_var}"
            %th.header_table.table_shelves
              = t('page.all.uroven_hran')
            %th.header_table.table_osn
              = t('page.all.osn_sec')
              %span.sub= "#{t('page.all.2_ram')}, #{@num_of_shelves_var} #{@text_var}"
            %th.header_table.table_pris
              = t('page.all.pris_sec')
              %span.sub= "#{t('page.all.1_ram')}, #{@num_of_shelves_var} #{@text_var}"
        %tbody
          %tr{ align: 'center' }
            %td= "#{@price_ram} #{t('page.all.uah')}"
            %td= "#{@price_shelves} #{t('page.all.uah')}"
            %td.is-total= "#{@price_stillage_osn} #{t('page.all.uah')}"
            %td.is-total= "#{@price_stillage_prist} #{t('page.all.uah')}"

  .pdp-schemes
    .pdp-scheme
      %h3.pdp-scheme__title= t('page.all.osn_sec_rash')
      .pdp-scheme__plate
        .dimensions_stillage_warehouse
          .indent_left_stilage_warehouse
          .dimension_image_stilage_warehouse
            .height_size_stilage_warehouse_primery
              = "#{@hight_var}"
            .widht_size_stilage_warehouse_primery
              = "#{@width_var}"
            .widht_section_size_stilage_warehouse_primery
              = "#{@width_var + 100}"
            .depth_size_stilage_warehouse_primery
              = "#{@depth_var}"
            = image_tag('design/all_parts/stillage_warehouse/Stilage_warehouse45_primary.gif', class: 'dimaension_image_size_stilage_warehouse')
          .indent_right_stilage_warehouse

    .pdp-scheme.prist_section
      %h3.pdp-scheme__title= t('page.all.pris_sec_rash')
      .pdp-scheme__plate
        .dimensions_stillage_warehouse
          .indent_left_stilage_warehouse
          .dimension_image_stilage_warehouse
            .height_size_stilage_warehouse_addl
              = "#{@hight_var}"
            .widht_size_stilage_warehouse_addl
              = "#{@width_var}"
            .widht_section_size_stilage_warehouse_addl
              = "#{@width_var + 50}"
            .depth_size_stilage_warehouse_addl
              = "#{@depth_var}"
            = image_tag('design/all_parts/stillage_warehouse/Stilage_warehouse45_addl.gif', class: 'dimaension_image_size_stilage_warehouse', style: 'margin-top: -12mm;')
          .indent_right_stilage_warehouse
