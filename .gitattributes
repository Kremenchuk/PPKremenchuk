# See https://git-scm.com/docs/gitattributes for more about git attribute files.

# Mark the database schema as having been generated.
db/schema.rb linguist-generated

# Mark any vendored files as having been vendored.
vendor/* linguist-vendored

# Shell scripts and the container entrypoint must keep LF endings even when
# checked out on Windows (core.autocrlf), otherwise `exec` fails inside the
# Linux image with "no such file or directory" on the CRLF shebang.
*.sh          text eol=lf
bin/*         text eol=lf
